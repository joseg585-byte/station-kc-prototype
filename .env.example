# ─────────────────────────────────────────────────────────────────────────
# the station — prototype environment template. Copy to `.env.local`.
#
# The app runs fully WITHOUT any of these set: menu/locations are seeded
# locally, checkout falls back to a mock "order placed" flow, and auth shows
# a "not configured" state instead of erroring. These vars light up the real
# integrations for a live pitch/demo.
# ─────────────────────────────────────────────────────────────────────────

# Supabase (auth + orders/gift-card persistence). Create a project at
# supabase.com, run supabase-schema.sql in the SQL editor, then paste:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Stripe (test-mode checkout for pickup orders + gift cards). Get test keys
# from the Stripe dashboard (Developers -> API keys). Use sk_test_/pk_test_.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Base URL used to build Stripe success/cancel redirect links. Defaults to
# http://localhost:3000 if unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend (transactional email for gift-card delivery). Get an API key from
# resend.com. Without it, gift card codes are shown on-screen instead of
# emailed, and logged to the server console.
RESEND_API_KEY=
RESEND_FROM_EMAIL=gifts@thestationkc.com
